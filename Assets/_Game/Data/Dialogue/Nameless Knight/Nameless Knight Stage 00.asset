  m_greetingStrings:
  - Still breathing, wanderer?
  - Come closer. I have no blade left for you.
  m_greetingAudioClips:
  - {fileID: 8300000, guid: 1f745405d7d0573429b3f0a833d01704, type: 3}
  - {fileID: 8300000, guid: 7b6465f6444bb9a40954f3b45b03cca3, type: 3}
  m_dialogueStrings:
  - The Ashen Crypt remembers every oath broken within it.
  - Rest at the grace before you descend. The dead do not tire.
  m_dialogueAudioClips:
  - {fileID: 8300000, guid: 7b6465f6444bb9a40954f3b45b03cca3, type: 3}
  - {fileID: 8300000, guid: b20a31592d5053b42a83ec42df6eb998, type: 3}
  m_farewellStrings:
  - Go carefully, wanderer.
