.equipment-menu { padding: 4%; }
.equipment-menu__header { width: 100%; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 24px; }
.equipment-menu__body { width: 100%; flex-direction: row; flex-grow: 1; min-height: 0; }
.equipment-menu__slots { width: 35%; padding-right: 24px; }
.equipment-menu__grid { flex-direction: row; flex-wrap: wrap; }
.equipment-slot { width: 30%; min-height: 110px; margin: 0 3% 12px 0; padding: 8px; background-color: rgb(38,35,27); border-width: 1px; border-color: rgb(55,71,81); border-radius: 0; }
.equipment-slot:hover { background-color: rgb(42,57,70); }
.equipment-slot:focus, .equipment-slot--selected { border-color: rgb(228,199,140); }
.equipment-slot__icon { width: 100%; height: 52px; margin-bottom: 6px; }
.equipment-slot__title { font-size: 16px; color: rgb(231,226,211); -unity-text-align: middle-center; }
.equipment-slot__quantity { font-size: 14px; color: rgb(175,169,149); -unity-text-align: middle-center; }
.equipment-menu__inventory { width: 31%; padding: 0 24px; border-left-width: 1px; border-left-color: rgb(74,66,48); }
.equipment-menu__search { min-height: 44px; margin-bottom: 12px; }
.equipment-menu__search .unity-text-field__input { background-color: rgb(40,37,30); color: rgb(235,229,215); padding: 6px; }
.equipment-menu__search .unity-base-field__label { color: rgb(182,193,196); min-width: 56px; }
.equipment-menu__inventory .menu-dropdown .unity-base-field__label { min-width: 56px; }
.equipment-menu__list { flex-grow: 1; min-height: 0; background-color: rgba(30,28,22,0.7); }
.equipment-menu__list .unity-collection-view__item--selected { background-color: rgb(76,65,42); border-left-width: 3px; border-left-color: rgb(220,192,135); }
.equipment-menu__details .menu-section-title { white-space: normal; }
.equipment-menu__details { width: 34%; padding-left: 24px; border-left-width: 1px; border-left-color: rgb(74,66,48); }
.equipment-menu__portrait { width: 110px; height: 110px; align-self: center; margin-bottom: 18px; }
.equipment-menu__comparison-title { color: rgb(188,175,145); font-size: 17px; margin: 24px 0 12px 0; }
.equipment-stat { flex-direction: row; justify-content: space-between; padding: 6px 0; border-bottom-width: 1px; border-bottom-color: rgb(57,51,37); }
.equipment-stat__label { color: rgb(175,169,149); font-size: 16px; }
.equipment-stat__value { color: rgb(223,213,191); font-size: 16px; }
.equipment-stat__value--better { color: rgb(117,156,207); }
.equipment-stat__value--worse { color: rgb(230,148,141); }
.equipment-menu__footer { width: 100%; flex-direction: row; align-items: center; margin-top: 20px; }
.equipment-menu__footer .menu-description { flex-grow: 1; flex-shrink: 1; margin-right: 20px; }
.equipment-menu__footer .menu-command { min-width: 110px; margin: 0 0 0 12px; }
.equipment-menu__header { margin-bottom: 10px; background-image: url("EldenRing/MENU_KUROOBI.png"); }
.equipment-menu .equipment-slot { background-color: rgba(50,46,35,0.7); border-color: rgba(177,157,111,0.3); border-radius: 0; }
.equipment-menu .equipment-slot:focus, .equipment-menu .equipment-slot--selected { border-color: rgb(228,199,140); background-color: rgba(94,80,48,0.6); }
.equipment-menu__categories .menu-tab { min-height: 42px; font-size: 17px; }
.equipment-menu .equipment-menu__list { background-color: rgba(25,24,20,0.7); }

.equipment-menu .menu-eyebrow { display: none; }
.menu-overlay.equipment-menu { padding: 3% 4%; }
.equipment-menu .menu-heading { height: 44px; margin-bottom: 12px; }
.equipment-menu .menu-title { font-size: 25px; }
.equipment-menu .menu-tabs { margin-bottom: 8px; }
.equipment-menu .menu-tabs .menu-tab { min-height: 34px; padding: 4px 16px; font-size: 17px; }
.equipment-menu .equipment-menu__inventory { display: none; }
.equipment-menu .equipment-menu__slots { width: 33%; }
.equipment-menu .equipment-menu__details { width: 40%; }
.equipment-menu .equipment-menu__status { width: 27%; padding-left: 22px; border-left-width: 1px; border-left-color: rgba(164,149,112,0.3); }
.equipment-menu--browsing .equipment-menu__slots { display: none; }
.equipment-menu--browsing .equipment-menu__inventory { display: flex; width: 33%; border-left-width: 0; padding-left: 0; }
.equipment-menu .menu-section-title { font-size: 19px; margin-bottom: 12px; }
.equipment-menu .equipment-menu__portrait { width: 110px; height: 110px; align-self: flex-end; margin-bottom: 8px; }
.equipment-menu .equipment-menu__search { min-height: 32px; margin-bottom: 4px; }
.equipment-menu .equipment-menu__search .unity-text-field__input { padding: 2px 6px; }
.equipment-menu .equipment-menu__inventory .menu-dropdown { min-height: 32px; margin-bottom: 8px; }
.equipment-menu .equipment-menu__inventory .menu-dropdown .unity-base-popup-field__input { min-height: 28px; }
.equipment-menu__status .character-status__heading { font-size: 17px; color: rgb(190,180,145); margin: 16px 0 8px 0; }
.equipment-menu__status .character-status__row { flex-direction: row; justify-content: space-between; min-height: 25px; font-size: 16px; }
