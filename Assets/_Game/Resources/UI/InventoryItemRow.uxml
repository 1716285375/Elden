<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="inventory-row" picking-mode="Ignore">
        <ui:Image name="item-icon" class="inventory-row__icon" picking-mode="Ignore" />
        <ui:VisualElement class="inventory-row__copy" picking-mode="Ignore">
            <ui:Label name="item-name" class="inventory-row__name" picking-mode="Ignore" />
            <ui:Label name="item-quantity" class="inventory-row__quantity" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
