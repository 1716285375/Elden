.item-grid__row { flex-direction: row; height: 94px; }
.item-grid__cell {
    width: 20%; height: 90px; padding: 4px; margin: 0; border-width: 0;
    background-image: url("EldenRing/Elements/MENU_SlotBase.png"); background-color: transparent;
}
.item-grid__cell:hover, .item-grid__cell:focus, .item-grid__cell--selected {
    background-image: url("EldenRing/Elements/MENU_SL_Cursor.png"); background-color: rgba(125,109,64,0.15);
}
.item-grid__icon { width: 100%; height: 100%; -unity-background-scale-mode: scale-to-fit; }
.item-grid__amount { position: absolute; right: 5px; bottom: 4px; font-size: 15px; color: rgb(229,221,195); }
.item-grid__equipped { position: absolute; left: 3px; top: 3px; width: 18px; height: 18px; background-image: url("EldenRing/Elements/MENU_EquMark.png"); -unity-background-scale-mode: scale-to-fit; }
